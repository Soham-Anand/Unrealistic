{
  "model_name": "unrealistic-alpha-450m",
  "vocab_size": 48000,
  "hidden_size": 1280,
  "intermediate_size": 3456,
  "num_hidden_layers": 22,
  "num_attention_heads": 20,
  "num_key_value_heads": 5,
  "max_position_embeddings": 2048,
  "rope_theta": 100000.0,
  "rms_norm_eps": 1e-06,
  "use_qk_norm": true,
  "hidden_act": "silu",
  "tie_word_embeddings": true,
  "backend": "tensorflow",
  "optimizer": {
    "type": "hybrid_muon_adamw",
    "supported_types": ["hybrid_muon_adamw", "adamw", "sinkgd", "muon"],
    "muon": {
      "lr": 0.02,
      "momentum": 0.95,
      "ns_steps": 5,
      "weight_decay": 0.01
    },
    "adamw": {
      "lr": 5e-04,
      "beta_1": 0.9,
      "beta_2": 0.95,
      "weight_decay": 0.01
    },
    "sinkgd": {
      "lr": 5e-04,
      "iters": 5,
      "weight_decay": 0.01
    }
  },
  "steps_per_execution": 64,
  "target_tokens": 8500000000,
  "seed": 42
}
