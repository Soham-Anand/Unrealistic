{
  "dtype": "bfloat16",
  "batch_size": 1,
  "gradient_accumulation_steps": 8,
  "grad_accum_eval_interval": 1,
  "gradient_checkpointing": true,
  "learning_rate": 1.0e-4,
  "lr_scheduler": "cosine",
  "warmup_steps": 100,
  "max_steps": 306584,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "sequence_length": 512,
  "seed": 42,
  "checkpoint_every": 500,
  "checkpoint_every_minutes": 60,
  "keep_last_checkpoints": 3,
  "log_every": 10,
  "eval_every": 500,
  "eval_steps": 200,
  "save_dir": "checkpoints",
  "dataset": "prabhakar_cot_math",
  "use_wandb": false,
  "max_training_time": 0,
  "data_paths": [
    "data/phase5/cot_train.bin"
  ],
  "eval_path": "data/phase5/cot_eval.bin",
  "sample_prompts": [
    "Multiply: 32 × 65",
    "Divide: 156 ÷ 8",
    "Add: 347 + 286",
    "Compute: 3^4",
    "A car travels at 50 km/h for 3 hours. How far does it go?",
    "Solve: 2x + 6 = 20",
    "A student says 15 x 4 = 50. Find the error.",
    "Verify: is x = 4 a solution to 2x + 6 = 14?",
    "What is 25% of 80?",
    "Add: 1/3 + 1/6"
  ],
  "sample_temperatures": [0.0, 0.5],
  "sample_max_tokens": 150,
  "sample_seed": 42
}
