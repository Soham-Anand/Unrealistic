{
  "dtype": "bfloat16",
  "batch_size": 1,
  "gradient_accumulation_steps": 8,
  "grad_accum_eval_interval": 1,
  "gradient_checkpointing": true,
  "learning_rate": 3e-4,
  "lr_scheduler": "cosine",
  "warmup_steps": 200,
  "max_steps": 24414,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "sequence_length": 1024,
  "seed": 42,
  "checkpoint_every": 1000,
  "checkpoint_every_minutes": 60,
  "keep_last_checkpoints": 3,
  "log_every": 10,
  "eval_every": 500,
  "eval_steps": 50,
  "save_dir": "checkpoints",
  "dataset": "openwebtext",
  "use_wandb": false,
  "max_training_time": 0,
  "data_paths": [
    "data/phase1/owt_train.bin"
  ],
  "eval_path": "data/phase1/owt_eval.bin",
  "sample_prompts": [
    "The",
    "Once upon a time,",
    "In this article,",
    "The capital of France is",
    "The opposite of hot is"
  ],
  "sample_temperatures": [0.0, 0.5],
  "sample_max_tokens": 100,
  "sample_seed": 42
}
