{
  "dtype": "float16",
  "batch_size": 4,
  "gradient_accumulation_steps": 8,
  "gradient_checkpointing": true,
  "learning_rate": 3e-4,
  "lr_scheduler": "cosine",
  "warmup_steps": 200,
  "max_steps": 50000,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "sequence_length": 512,
  "seed": 42,
  "checkpoint_every": 1000,
  "log_every": 10,
  "eval_every": 500,
  "eval_steps": 50,
  "save_dir": "checkpoints",
  "dataset": "tinystories",
  "use_wandb": false
}
