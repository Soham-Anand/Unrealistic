{
  "dtype": "bfloat16",
  "batch_size": 1,
  "gradient_accumulation_steps": 8,
  "grad_accum_eval_interval": 1,
  "gradient_checkpointing": true,
  "learning_rate": 3e-4,
  "lr_scheduler": "cosine",
  "warmup_steps": 200,
  "max_steps": 50,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "sequence_length": 1024,
  "seed": 42,
  "checkpoint_every": 99999,
  "checkpoint_every_minutes": 99999,
  "log_every": 1,
  "eval_every": 99999,
  "eval_steps": 10,
  "save_dir": "checkpoints",
  "dataset": "phase1",
  "use_wandb": false,
  "max_training_time": 0,
  "data_paths": [
    "data/phase1/slice_0.bin",
    "data/phase1/slice_1.bin",
    "data/phase1/slice_2.bin",
    "data/phase1/slice_3.bin",
    "data/phase1/slice_4.bin"
  ],
  "eval_path": "data/phase1/eval.bin"
}
